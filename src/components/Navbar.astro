---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];

// Cible du sélecteur de langue : chemin de l'autre langue.
const otherLang: Lang = lang === 'fr' ? 'en' : 'fr';
const otherHref = otherLang === 'fr' ? '/' : '/en/';
const homeHref = lang === 'fr' ? '/' : '/en/';
---

<header class="site-header">
  <nav class="ds-navbar" data-ds-navbar aria-label={t.nav.menu}>
    <a class="ds-navbar__brand" href={homeHref + '#top'}>matheo.ngn</a>
    <button
      type="button"
      class="ds-navbar__toggle"
      aria-controls="ds-navbar-menu-primary"
      aria-expanded="false"
      aria-label={t.nav.menu}
    >
      {t.nav.menu}
    </button>
    <ul class="ds-navbar__menu" id="ds-navbar-menu-primary">
      <li class="ds-navbar__item">
        <a class="ds-navbar__link" href="#a-propos">{t.nav.about}</a>
      </li>
      <li class="ds-navbar__item">
        <a class="ds-navbar__link" href="#formation">{t.nav.education}</a>
      </li>
      <li class="ds-navbar__item">
        <a class="ds-navbar__link" href="#experiences">{t.nav.experience}</a>
      </li>
      <li class="ds-navbar__item">
        <a class="ds-navbar__link" href="#competences">{t.nav.skills}</a>
      </li>
      <li class="ds-navbar__item">
        <a class="ds-navbar__link" href="#projets">{t.nav.projects}</a>
      </li>
      <li class="ds-navbar__item">
        <a class="ds-navbar__link" href="#contact">{t.nav.contact}</a>
      </li>
      <li class="ds-navbar__item">
        <a
          class="ds-link ds-link--muted lang-switch"
          href={otherHref}
          hreflang={otherLang}
          aria-label={`${t.nav.langLabel}: ${otherLang.toUpperCase()}`}
        >
          {otherLang.toUpperCase()}
        </a>
      </li>
      <li class="ds-navbar__item">
        <button
          type="button"
          id="theme-toggle"
          class="ds-icon-button ds-icon-button--secondary theme-toggle"
          aria-label={t.nav.themeToggle}
        >
          <svg
            class="ds-icon-button__icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-8.54-6.54C12.46 3.04 12.23 3 12 3z"
            ></path>
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      const root = document.documentElement;
      const current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (_) {
        /* stockage indisponible : la bascule reste effective pour la session */
      }
    });
  })();
</script>

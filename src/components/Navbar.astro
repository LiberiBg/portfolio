---
// Navbar du site : réutilise le composant ds-navbar du design system.
// data-ds-navbar active la bascule mobile (amélioration progressive).
// Le bouton de thème réutilise ds-icon-button.
---

<header class="site-header">
  <nav class="ds-navbar" data-ds-navbar aria-label="Navigation principale">
    <a class="ds-navbar__brand" href="#top">matheo.ngn</a>
    <button
      type="button"
      class="ds-navbar__toggle"
      aria-controls="ds-navbar-menu-primary"
      aria-expanded="false"
      aria-label="Ouvrir le menu de navigation"
    >
      Menu
    </button>
    <ul class="ds-navbar__menu" id="ds-navbar-menu-primary">
      <li class="ds-navbar__item">
        <a class="ds-navbar__link" href="#a-propos">À propos</a>
      </li>
      <li class="ds-navbar__item">
        <a class="ds-navbar__link" href="#experiences">Expériences</a>
      </li>
      <li class="ds-navbar__item">
        <a class="ds-navbar__link" href="#competences">Compétences</a>
      </li>
      <li class="ds-navbar__item">
        <a class="ds-navbar__link" href="#projets">Projets</a>
      </li>
      <li class="ds-navbar__item">
        <a class="ds-navbar__link" href="#contact">Contact</a>
      </li>
      <li class="ds-navbar__item">
        <button
          type="button"
          id="theme-toggle"
          class="ds-icon-button ds-icon-button--secondary theme-toggle"
          aria-label="Basculer le thème clair/sombre"
        >
          <svg
            class="ds-icon-button__icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-8.54-6.54C12.46 3.04 12.23 3 12 3z"
            ></path>
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script is:inline>
  // Bascule de thème : met à jour data-theme sur <html> et persiste le choix.
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      const root = document.documentElement;
      const current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (_) {
        /* stockage indisponible : la bascule reste effective pour la session */
      }
    });
  })();
</script>
